    {
        "id": "4e46197c4ff50eb7",
        "type": "function",
        "z": "cc75426cc1f703c2",
        "name": "Preparar alerta",
        "func": "const a = msg.payload;\nif (!a || typeof a !== 'object') return null;\n\nconst quando = new Date().toLocaleString('pt-BR', {timeZone: 'America/Sao_Paulo'});\n\n// histórico dos últimos 5 alertas para o dashboard\nlet hist = flow.get('historico_alertas') || [];\nhist.unshift({quando: quando, mensagem: a.mensagem, valor: a.valor});\nhist = hist.slice(0, 5);\nflow.set('historico_alertas', hist);\n\n// 1) dashboard\nconst dash = {payload: {ultimos: hist}};\n\n// 2) Google Sheets (aba \"Alertas\")\nconst planilha = {\n  payload: {aba: 'Alertas', linha: [quando, a.tipo, a.mensagem, a.valor]},\n  headers: {'Content-Type': 'application/json'}\n};\n\n// 3) e-mail\nconst email = {\n  topic: 'ALERTA - Casa Inteligente: ' + a.mensagem,\n  payload: 'Alerta registrado em ' + quando + '\\n\\n' +\n           'Tipo: ' + a.tipo + '\\n' +\n           'Mensagem: ' + a.mensagem + '\\n' +\n           'Valor: ' + a.valor\n};\n\nreturn [dash, planilha, email];",
