        "format": "\n<template>\n  <div class=\"card\">\n    <div class=\"head\"><span>VENTILADOR</span><span class=\"ico\">🌀</span></div>\n    <div class=\"val\" :class=\"msg?.payload?.ligado ? 'on' : 'off'\">{{ msg?.payload?.ligado ? 'LIGADO' : 'DESLIGADO' }}</div>\n    <div class=\"st\">{{ 'Modo: ' + (msg?.payload?.modo ?? '--') }}</div>\n    <div class=\"btns\" style=\"margin-top:12px\">\n      <button class=\"main\" @click=\"send({payload: 'AUTO'})\">Automático</button>\n      <button class=\"\" @click=\"send({payload: 'ON'})\">Ligar</button>\n      <button class=\"\" @click=\"send({payload: 'OFF'})\">Desligar</button>\n    </div>\n  </div>\n</template>\n\n<style>\n.card{background:#fff;border:1px solid #e1e8df;border-radius:16px;padding:20px;color:#24372a;font-family:Arial,sans-serif;box-sizing:border-box;width:100%}\n.head{display:flex;align-items:center;justify-content:space-between;color:#657568;font-size:12px;font-weight:700;letter-spacing:.5px}\n.ico{font-size:24px}\n.val{font-size:34px;font-weight:700;margin:16px 0}\n.val small{font-size:16px;color:#657568;margin-left:5px}\n.st{color:#218447;font-size:12px}\n.st.warn{color:#c0392b;font-weight:700}\n.btns{display:flex;gap:8px;flex-wrap:wrap}\n.btns button{flex:1;padding:9px 10px;border:1px solid #0d74ce;border-radius:8px;background:#fff;color:#0d74ce;font-weight:700;cursor:pointer}\n.btns button.main{background:#0d74ce;color:#fff}\n.btns button:hover{opacity:.85}\n.on{color:#218447}.off{color:#657568}\n.lista{margin:12px 0 0;padding:0;list-style:none;font-size:13px}\n.lista li{padding:6px 0;border-top:1px solid #eef1ec}\n</style>\n",
